{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm --prefix frontend build",
  "outputDirectory": "frontend/.output/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://marketmaster-backend.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
